{
  "name": "hud",
  "version": "1.0.0",
  "displayName": "Hud",
  "description": "Service, endpoint, function and investigation dashboards for applications instrumented with the Hud SDK. Requires OpenSearch Dashboards 3.x with Explore and a Prometheus direct-query data source named hud_prometheus.",
  "license": "Apache-2.0",
  "type": "logs",
  "labels": ["Observability", "Logs", "Metrics"],
  "author": "Hud",
  "sourceUrl": "https://github.com/opensearch-project/opensearch-catalog/tree/main/integrations/observability/hud/info",
  "workflows": [
    {
      "name": "dashboards",
      "label": "Dashboards & Visualizations",
      "description": "Dashboards and index patterns for Hud service, endpoint, function and investigation data.",
      "enabled_by_default": true
    }
  ],
  "statics": {
    "logo": {
      "annotation": "Hud Logo",
      "path": "logo.svg"
    }
  },
  "components": [
    { "name": "logs", "version": "1.0.0" }
  ],
  "assets": [
    { "name": "hud-shared", "version": "1.0.0", "extension": "ndjson", "type": "savedObjectBundle", "workflows": ["dashboards"] },
    { "name": "hud-service-overview", "version": "1.0.0", "extension": "ndjson", "type": "savedObjectBundle", "workflows": ["dashboards"] },
    { "name": "hud-endpoints", "version": "1.0.0", "extension": "ndjson", "type": "savedObjectBundle", "workflows": ["dashboards"] },
    { "name": "hud-functions", "version": "1.0.0", "extension": "ndjson", "type": "savedObjectBundle", "workflows": ["dashboards"] },
    { "name": "hud-function", "version": "1.0.0", "extension": "ndjson", "type": "savedObjectBundle", "workflows": ["dashboards"] },
    { "name": "hud-investigations", "version": "1.0.0", "extension": "ndjson", "type": "savedObjectBundle", "workflows": ["dashboards"] }
  ]
}
